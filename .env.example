# Telegram bot token from @BotFather
BOT_TOKEN=123456:ABC-DEF...

# Stripe secret key (sk_test_... or sk_live_...) from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_XXXX

# Stripe webhook signing secret (whsec_...) from your Stripe webhook endpoint.
# Set this to auto-grant access on payment. If empty, use /grant manually.
STRIPE_WEBHOOK_SECRET=whsec_XXXX

# The private group/channel that members gain access to.
# Can be the numeric id (e.g. -1001234567890) or @username (e.g. @mygroup)
TARGET_CHAT_ID=-1001234567890

# Telegram user ids (comma separated) who can run admin commands like /grant and /revoke
ADMIN_IDS=123456789

# Membership price in the smallest currency unit (cents). Example: 500 = $5.00
PRICE_AMOUNT=500
CURRENCY=USD

# Membership duration in days (how long one purchase lasts)
PLAN_DAYS=30
PLAN_TITLE="Premium Membership"
PLAN_DESCRIPTION="Access to the private members group"

# Grant method: "invite_link" (send a one-time invite link) or "approve" (auto-approve join requests)
GRANT_METHOD=invite_link

# ---- Webhook deployment (only needed if STRIPE_WEBHOOK_SECRET is set) ----
# Public URL where this bot runs, e.g. https://mybot.fly.dev
BASE_URL=https://mybot.fly.dev
# Where Stripe redirects the user after a successful payment (any URL, e.g. t.me/yourbot)
PAYMENT_SUCCESS_URL=https://t.me/elsinkiepobot
